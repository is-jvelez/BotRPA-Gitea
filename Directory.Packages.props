<Project>
  <!-- Versiones centralizadas (Central Package Management). Los .csproj no llevan Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Permite fijar versiones de dependencias transitivas (parches de seguridad). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Application -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- Infrastructure -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- IMPORTANTE: debe coincidir con el tag de la imagen base del target `runtime` del Dockerfile
         (mcr.microsoft.com/playwright/dotnet:v<versión>-noble). Cambiar ambos a la vez. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- Worker -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pin transitivo: Microsoft.Data.SqlClient 7.1.1 trae 9.0.18, con avisos
         GHSA-2fmv-rv2c-59x7 y GHSA-846f-f764-76mx. Quitar cuando SqlClient lo actualice. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bots.Infrastructure\Bots.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Servidor Gitea falso (Kestrel) para los tests de Playwright: viene con el SDK, sin paquetes NuGet. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las mismas migraciones que aplica Flyway: los tests corren contra el esquema real. -->
    <None Include="..\..\flyway\sql\*.sql" LinkBase="flyway" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

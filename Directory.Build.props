<Project>
  <!-- Configuración común a todos los proyectos de la solución. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- Reglas "recommended" de los analizadores .NET (rendimiento del logging, cultura...). Versión fija
         para que una actualización del SDK no rompa el build con reglas nuevas; subirla a propósito. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
  </PropertyGroup>
</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "Bots": {
    "Schedule": {
      "Cron": "0 * * * *",
      "TimeZone": "America/Guayaquil"
    },
    "AllowEmptySource": false,
    "Recovery": {
      "MaxAttempts": 3,
      "StaleRunThreshold": "00:30:00"
    },
    "Resilience": {
      "Sql": {
        "MaxRetryAttempts": 3,
        "BaseDelay": "00:00:01",
        "MaxDelay": "00:00:30",
        "BreakerFailureRatio": 0.5,
        "BreakerSamplingDuration": "00:01:00",
        "BreakerMinimumThroughput": 10,
        "BreakDuration": "00:00:30"
      },
      "Gitea": {
        "MaxRetryAttempts": 2,
        "BaseDelay": "00:00:02",
        "MaxDelay": "00:00:30",
        "BreakerFailureRatio": 0.5,
        "BreakerSamplingDuration": "00:02:00",
        "BreakerMinimumThroughput": 10,
        "BreakDuration": "00:01:00"
      }
    }
  },
  "Gitea": {
    "BaseUrl": "http://localhost:3000",
    "NavigationTimeout": "00:00:30",
    "ActionTimeout": "00:00:10",
    "MaxPages": 200,
    "Headless": true,
    "VisualDebug": false,
    "VideoDirectory": "videos"
  },
  "Sql": {
    "Server": "localhost,1433",
    "Database": "BotsDb",
    "TrustServerCertificate": false,
    "ConnectTimeoutSeconds": 15
  }
}

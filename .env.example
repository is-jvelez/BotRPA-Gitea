# Copiar a .env (no versionado) y reemplazar los CAMBIAR_ESTO.
# Contraseñas: se admiten comillas y ; (sql-init las escapa). Si una lleva $, escribe el valor entre
# comillas simples ('...'): si no, docker compose intentaría interpolarlo como variable.

# --- SQL Server ---
MSSQL_TAG=2022-CU27-ubuntu-22.04 # tag probado
# Digest del tag anterior (con la @). Si cambias MSSQL_TAG, cambia también el digest o déjalo vacío
# (MSSQL_DIGEST=): con un digest de otro tag, Docker usa el digest e ignora el tag.
MSSQL_DIGEST=@sha256:4402d880dd4c34bfa7d8705e56a86cd6c88da80a1f6bbbe741f999e76264a090
MSSQL_SA_PASSWORD=CAMBIAR_ESTO   # política: 8+ caracteres, 3 de 4 tipos

# --- Usuarios de base de datos (solo letras, dígitos y _) ---
FLYWAY_DB_USER=flyway_migrator
FLYWAY_DB_PASSWORD=CAMBIAR_ESTO
APP_DB_USER=bots_app
APP_DB_PASSWORD=CAMBIAR_ESTO

# --- Gitea (credenciales del usuario cuyos repos se procesan) ---
GITEA_BASE_URL=http://host.docker.internal:3000   # fuera de Docker: http://localhost:3000
GITEA_USER=CAMBIAR_ESTO
GITEA_PASSWORD=CAMBIAR_ESTO

# --- Bot ---
BOTS_SCHEDULE_CRON=CAMBIAR_ESTO        # recomendado: 0 * * * * (cada hora); */5 * * * * solo para pruebas
BOTS_SCHEDULE_TIMEZONE=America/Guayaquil
BOTS_ALLOW_EMPTY_SOURCE=false
BOTS_RECOVERY_MAX_ATTEMPTS=3
# parámetros de Polly (reintentos, backoff, circuit breaker): con valores por defecto razonables
